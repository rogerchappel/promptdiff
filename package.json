{
  "name": "promptdiff",
  "version": "0.1.0",
  "description": "Local-first CLI for comparing prompt and template revisions for risky instruction, tool, and output-contract changes.",
  "type": "module",
  "bin": {
    "promptdiff": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:tag": "node scripts/validate-release-tag.mjs",
    "release:check": "npm run check && npm test && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "prompt",
    "diff",
    "cli",
    "ai-safety",
    "agent-tools",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/promptdiff.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/promptdiff/issues"
  },
  "homepage": "https://github.com/rogerchappel/promptdiff#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rogerchappel"
  }
}
